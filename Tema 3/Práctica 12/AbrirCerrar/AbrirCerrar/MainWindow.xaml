<Window x:Class="AbrirCerrar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AbrirCerrar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Menu>
                <MenuItem Header="Archivo">
                    <MenuItem Header="Abrir" Click="AbrirArchivo"></MenuItem>
                    <MenuItem Header="Guardar" Click="GuardarArchivo"></MenuItem>
                </MenuItem>
            </Menu>
            <TextBox Name="tbInfo" TextAlignment="Center" Width="500" Height="300" Margin="50"/>
        </StackPanel>
    </Grid>
</Window>
